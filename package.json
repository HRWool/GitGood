{
  "name": "gitgood",
  "description": "Git Good clickable prototype (ITSC 3155 Group 7)",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "start": "node server/index.js",
    "start:static": "python3 -m http.server 8000",
    "test": "node --test \"tests/*.test.js\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:check": "node prisma/check-connection.js",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed && npm run db:check",
    "db:test:setup": "node prisma/setup-test-db.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRWool/GitGood.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/HRWool/GitGood/issues"
  },
  "homepage": "https://github.com/HRWool/GitGood#readme",
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^15.15.0",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "private": true,
  "version": "1.0.0"
}
